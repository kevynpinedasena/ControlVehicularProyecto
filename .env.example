# Variables de entorno compartidas por docker-compose (raíz del proyecto)

# PostgreSQL
POSTGRES_USER=conjunto_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=conjunto_db
POSTGRES_PORT=5434

# Backend
BACKEND_PORT=8010
SECRET_KEY=cambiar_por_una_clave_secreta_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production
FRONTEND_URL=http://localhost:5173

# Administrador de plataforma (se crea automáticamente al arrancar si no existe)
# Cambia estos valores antes de desplegar en un entorno público
ADMIN_PLATAFORMA_CORREO=plataforma@conjunto.com
ADMIN_PLATAFORMA_PASSWORD=cambiar_esta_clave_antes_de_desplegar

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8010/api/v1
